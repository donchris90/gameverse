{
  "expo": {
    "name": "GameVerse",
    "slug": "gameverse",
    "scheme": "gameverse",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": ["expo-router", "expo-dev-client"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.gameverse.app.dev",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "GameVerse uses the microphone for voice chat in matches."
      }
    },
    "android": {
      "package": "com.gameverse.app.dev",
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS", "INTERNET"]
    }
  }
}
