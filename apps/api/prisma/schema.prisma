// GameVerse database schema.
// Phase 0 scope: accounts, social identities, refresh tokens, one-time tokens.
// Later phases add their own models via new migrations - never edit applied migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_DELETION
  DELETED
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum OneTimeTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_DELETION
}

model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// Lower-cased, trimmed. Unique.
  email        String  @unique
  /// Null for accounts that only use social sign-in.
  passwordHash String?

  /// Calendar date of birth. Used only for the age gate; never exposed by any API.
  dateOfBirth     DateTime @db.Date
  termsVersion    String
  termsAcceptedAt DateTime @db.Timestamptz(3)

  emailVerifiedAt DateTime? @db.Timestamptz(3)
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime? @db.Timestamptz(3)
  /// Set when the account is deleted; the row stays as an anonymised tombstone (see AccountService).
  deletedAt       DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  identities    AuthIdentity[]
  refreshTokens RefreshToken[]
  oneTimeTokens OneTimeToken[]
  profile       UserProfile?
  settings      UserSettings?

  sentFriendRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")
  friendshipsAsLow       Friendship[]    @relation("FriendshipLow")
  friendshipsAsHigh      Friendship[]    @relation("FriendshipHigh")
  blocksMade             BlockedUser[]   @relation("BlockBlocker")
  blocksReceived         BlockedUser[]   @relation("BlockBlocked")

  conversationsAsLow  Conversation[]       @relation("ConversationLow")
  conversationsAsHigh Conversation[]       @relation("ConversationHigh")
  conversationMembers ConversationMember[]
  messagesSent        Message[]

  reportsMade    ModerationReport[] @relation("ReportReporter")
  reportsAgainst ModerationReport[] @relation("ReportReported")
  moderationActionsAgainst ModerationAction[]

  deviceTokens DeviceToken[]

  @@index([status])
  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  /// The provider's stable subject identifier (`sub`).
  providerUserId String
  email          String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  /// All tokens descended from one login share a family; reuse of a rotated token revokes the family.
  familyId   String    @db.Uuid
  /// SHA-256 (hex) of the opaque token. The raw token is never stored.
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  replacedById String?  @db.Uuid
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OneTimeToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  type      OneTimeTokenType
  /// SHA-256 (hex) of the opaque token. The raw token is only ever sent by email.
  tokenHash String           @unique
  expiresAt DateTime         @db.Timestamptz(3)
  usedAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("one_time_tokens")
}

enum ProfileVisibility {
  EVERYONE
  FRIENDS
}

enum OnlineStatusVisibility {
  EVERYONE
  FRIENDS
  NOBODY
}

enum DirectMessagePolicy {
  EVERYONE
  FRIENDS
  NOBODY
}

model UserProfile {
  userId String @id @db.Uuid

  /// As typed by the user (case preserved for display).
  username          String
  /// Lower-cased copy; the uniqueness key.
  usernameLower     String    @unique
  avatarId          String
  bio               String?   @db.VarChar(160)
  usernameChangedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Privacy defaults are conservative: everything friends-only (product spec section 6).
model UserSettings {
  userId String @id @db.Uuid

  profileVisibility      ProfileVisibility      @default(FRIENDS)
  onlineStatusVisibility OnlineStatusVisibility @default(FRIENDS)
  dmPolicy               DirectMessagePolicy    @default(FRIENDS)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

enum FriendRequestStatus {
  PENDING
  REJECTED
}

/// At most one row per pair of users (either direction), enforced by the unique key on the ordered
/// pair. A REJECTED row is kept for the cooldown so the sender cannot spam; the sender is never told.
model FriendRequest {
  id          String              @id @default(uuid(7)) @db.Uuid
  senderId    String              @db.Uuid
  receiverId  String              @db.Uuid
  /// The pair of user ids in sorted order (low < high), so A->B and B->A collide on one key.
  userLowId   String              @db.Uuid
  userHighId  String              @db.Uuid
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  respondedAt DateTime?           @db.Timestamptz(3)

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@map("friend_requests")
}

/// One row per friendship, stored once with the ids sorted (low < high; CHECK in the migration).
model Friendship {
  id         String   @id @default(uuid(7)) @db.Uuid
  userLowId  String   @db.Uuid
  userHighId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  userLow  User @relation("FriendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("FriendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userHighId])
  @@map("friendships")
}

model BlockedUser {
  id        String   @id @default(uuid(7)) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocked_users")
}

/// A 1:1 conversation; exactly one per pair of users (sorted-pair unique key).
model Conversation {
  id            String    @id @default(uuid(7)) @db.Uuid
  userLowId     String    @db.Uuid
  userHighId    String    @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  /// Set when a message is sent; used to order the conversation list.
  lastMessageAt DateTime? @db.Timestamptz(3)

  userLow  User @relation("ConversationLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("ConversationHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  members  ConversationMember[]
  messages Message[]

  @@unique([userLowId, userHighId])
  @@index([userHighId])
  @@index([userLowId, lastMessageAt])
  @@map("conversations")
}

/// Per-person state for a conversation: read position and mute.
model ConversationMember {
  conversationId    String   @db.Uuid
  userId            String   @db.Uuid
  /// Messages are UUIDv7 (time ordered), so "read up to" is the greatest message id the user has seen.
  lastReadMessageId String?  @db.Uuid
  /// Muted conversations still deliver in-app but send no push notifications.
  muted             Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id              String   @id @default(uuid(7)) @db.Uuid
  conversationId  String   @db.Uuid
  senderId        String   @db.Uuid
  body            String   @db.VarChar(2000)
  /// Client-generated idempotency key: a retried send returns the original message.
  clientMessageId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, id])
  @@index([senderId, createdAt])
  @@map("messages")
}

enum ReportReason {
  HARASSMENT
  HATE
  SEXUAL_CONTENT
  SPAM
  IMPERSONATION
  UNDERAGE
  CHEATING
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  SUSPEND
  BAN
  REINSTATE
}

model ModerationReport {
  id             String       @id @default(uuid(7)) @db.Uuid
  reporterId     String       @db.Uuid
  reportedUserId String       @db.Uuid
  reason         ReportReason
  details        String?      @db.VarChar(500)
  status         ReportStatus @default(OPEN)

  /// Set for message reports. Not a foreign key: the snapshot below is the evidence.
  messageId       String? @db.Uuid
  messageSnapshot String? @db.VarChar(2000)
  /// Up to five earlier messages in the same conversation, so moderators can judge context.
  contextSnapshot Json?

  /// "reporter:reported:message-or-user" while OPEN, null once closed. Unique, so the same person
  /// cannot queue the same report twice, even by racing requests.
  dedupeKey String? @unique

  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt     DateTime? @db.Timestamptz(3)
  /// Staff account ids are plain columns (no foreign key) so history survives staff changes.
  resolvedById   String?   @db.Uuid
  resolutionNote String?   @db.VarChar(500)

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportReported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status, id])
  @@index([reportedUserId])
  @@index([reporterId, createdAt])
  @@map("moderation_reports")
}

model ModerationAction {
  id           String               @id @default(uuid(7)) @db.Uuid
  moderatorId  String               @db.Uuid
  targetUserId String               @db.Uuid
  type         ModerationActionType
  reason       String               @db.VarChar(500)
  reportId     String?              @db.Uuid
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)

  target User @relation(fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@map("moderation_actions")
}

/// Append-only (a database trigger rejects UPDATE and DELETE). No foreign keys, so history is
/// never lost or cascaded away.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?  @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetId, id])
  @@index([actorId, id])
  @@map("audit_logs")
}

enum DevicePlatform {
  IOS
  ANDROID
}

/// An Expo push token. One token belongs to one account at a time: registering it for another
/// account moves it, so a shared or handed-over phone never delivers the previous owner's alerts.
model DeviceToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @db.Uuid
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
