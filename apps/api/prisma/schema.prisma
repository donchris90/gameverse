// GameVerse database schema.
// Phase 0 scope: accounts, social identities, refresh tokens, one-time tokens.
// Later phases add their own models via new migrations - never edit applied migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_DELETION
  DELETED
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum OneTimeTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_DELETION
}

model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// Lower-cased, trimmed. Unique.
  email        String  @unique
  /// Null for accounts that only use social sign-in.
  passwordHash String?

  /// Calendar date of birth. Used only for the age gate; never exposed by any API.
  dateOfBirth     DateTime @db.Date
  termsVersion    String
  termsAcceptedAt DateTime @db.Timestamptz(3)

  emailVerifiedAt DateTime?  @db.Timestamptz(3)
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?  @db.Timestamptz(3)
  /// Set when the account is deleted; the row stays as an anonymised tombstone (see AccountService).
  deletedAt       DateTime?  @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  identities    AuthIdentity[]
  refreshTokens RefreshToken[]
  oneTimeTokens OneTimeToken[]
  profile       UserProfile?
  settings      UserSettings?

  sentFriendRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")
  friendshipsAsLow       Friendship[]    @relation("FriendshipLow")
  friendshipsAsHigh      Friendship[]    @relation("FriendshipHigh")
  blocksMade             BlockedUser[]   @relation("BlockBlocker")
  blocksReceived         BlockedUser[]   @relation("BlockBlocked")

  conversationsAsLow  Conversation[]       @relation("ConversationLow")
  conversationsAsHigh Conversation[]       @relation("ConversationHigh")
  conversationMembers ConversationMember[]
  messagesSent        Message[]

  reportsMade              ModerationReport[] @relation("ReportReporter")
  reportsAgainst           ModerationReport[] @relation("ReportReported")
  moderationActionsAgainst ModerationAction[]

  deviceTokens DeviceToken[]

  gameSeats       GameMatchPlayer[]
  resultSeats     GameResultPlayer[] @relation("ResultPlayerUser")
  ratings         PlayerRating[]     @relation("PlayerRatingUser")
  statistics      PlayerStatistics[] @relation("PlayerStatisticsUser")
  experience      PlayerExperience?  @relation("PlayerExperienceUser")
  coinWallet      CoinWallet?        @relation("CoinWalletUser")
  coinLedger      CoinLedger[]       @relation("CoinLedgerUser")
  hostedRooms     GameRoom[]         @relation("RoomHost")
  roomInvites     GameRoom[]         @relation("RoomInvitee")
  queueEntry      MatchQueueEntry?   @relation("QueueUser")
  roomMemberships GameRoomMember[]   @relation("RoomMemberUser")
  voiceSessions   VoiceSession[]

  @@index([status])
  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  /// The provider's stable subject identifier (`sub`).
  providerUserId String
  email          String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  /// All tokens descended from one login share a family; reuse of a rotated token revokes the family.
  familyId     String    @db.Uuid
  /// SHA-256 (hex) of the opaque token. The raw token is never stored.
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.Uuid
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OneTimeToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  type      OneTimeTokenType
  /// SHA-256 (hex) of the opaque token. The raw token is only ever sent by email.
  tokenHash String           @unique
  expiresAt DateTime         @db.Timestamptz(3)
  usedAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("one_time_tokens")
}

enum ProfileVisibility {
  EVERYONE
  FRIENDS
}

enum OnlineStatusVisibility {
  EVERYONE
  FRIENDS
  NOBODY
}

enum DirectMessagePolicy {
  EVERYONE
  FRIENDS
  NOBODY
}

model UserProfile {
  userId String @id @db.Uuid

  /// As typed by the user (case preserved for display).
  username          String
  /// Lower-cased copy; the uniqueness key.
  usernameLower     String    @unique
  avatarId          String
  bio               String?   @db.VarChar(160)
  usernameChangedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Privacy defaults are conservative: everything friends-only (product spec section 6).
model UserSettings {
  userId String @id @db.Uuid

  profileVisibility      ProfileVisibility      @default(FRIENDS)
  onlineStatusVisibility OnlineStatusVisibility @default(FRIENDS)
  dmPolicy               DirectMessagePolicy    @default(FRIENDS)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

enum FriendRequestStatus {
  PENDING
  REJECTED
}

/// At most one row per pair of users (either direction), enforced by the unique key on the ordered
/// pair. A REJECTED row is kept for the cooldown so the sender cannot spam; the sender is never told.
model FriendRequest {
  id          String              @id @default(uuid(7)) @db.Uuid
  senderId    String              @db.Uuid
  receiverId  String              @db.Uuid
  /// The pair of user ids in sorted order (low < high), so A->B and B->A collide on one key.
  userLowId   String              @db.Uuid
  userHighId  String              @db.Uuid
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  respondedAt DateTime?           @db.Timestamptz(3)

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@map("friend_requests")
}

/// One row per friendship, stored once with the ids sorted (low < high; CHECK in the migration).
model Friendship {
  id         String   @id @default(uuid(7)) @db.Uuid
  userLowId  String   @db.Uuid
  userHighId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  userLow  User @relation("FriendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("FriendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userHighId])
  @@map("friendships")
}

model BlockedUser {
  id        String   @id @default(uuid(7)) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocked_users")
}

/// A 1:1 conversation; exactly one per pair of users (sorted-pair unique key).
model Conversation {
  id            String    @id @default(uuid(7)) @db.Uuid
  userLowId     String    @db.Uuid
  userHighId    String    @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  /// Set when a message is sent; used to order the conversation list.
  lastMessageAt DateTime? @db.Timestamptz(3)

  userLow  User @relation("ConversationLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("ConversationHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  members  ConversationMember[]
  messages Message[]

  @@unique([userLowId, userHighId])
  @@index([userHighId])
  @@index([userLowId, lastMessageAt])
  @@map("conversations")
}

/// Per-person state for a conversation: read position and mute.
model ConversationMember {
  conversationId    String   @db.Uuid
  userId            String   @db.Uuid
  /// Messages are UUIDv7 (time ordered), so "read up to" is the greatest message id the user has seen.
  lastReadMessageId String?  @db.Uuid
  /// Muted conversations still deliver in-app but send no push notifications.
  muted             Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id              String   @id @default(uuid(7)) @db.Uuid
  conversationId  String   @db.Uuid
  senderId        String   @db.Uuid
  body            String   @db.VarChar(2000)
  /// Client-generated idempotency key: a retried send returns the original message.
  clientMessageId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, id])
  @@index([senderId, createdAt])
  @@map("messages")
}

enum ReportReason {
  HARASSMENT
  HATE
  SEXUAL_CONTENT
  SPAM
  IMPERSONATION
  UNDERAGE
  CHEATING
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  SUSPEND
  BAN
  REINSTATE
}

model ModerationReport {
  id             String       @id @default(uuid(7)) @db.Uuid
  reporterId     String       @db.Uuid
  reportedUserId String       @db.Uuid
  reason         ReportReason
  details        String?      @db.VarChar(500)
  status         ReportStatus @default(OPEN)

  /// Set for message reports. Not a foreign key: the snapshot below is the evidence.
  messageId       String? @db.Uuid
  messageSnapshot String? @db.VarChar(2000)
  /// Up to five earlier messages in the same conversation, so moderators can judge context.
  contextSnapshot Json?

  /// "reporter:reported:message-or-user" while OPEN, null once closed. Unique, so the same person
  /// cannot queue the same report twice, even by racing requests.
  dedupeKey String? @unique

  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt     DateTime? @db.Timestamptz(3)
  /// Staff account ids are plain columns (no foreign key) so history survives staff changes.
  resolvedById   String?   @db.Uuid
  resolutionNote String?   @db.VarChar(500)

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportReported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status, id])
  @@index([reportedUserId])
  @@index([reporterId, createdAt])
  @@map("moderation_reports")
}

model ModerationAction {
  id           String               @id @default(uuid(7)) @db.Uuid
  moderatorId  String               @db.Uuid
  targetUserId String               @db.Uuid
  type         ModerationActionType
  reason       String               @db.VarChar(500)
  reportId     String?              @db.Uuid
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)

  target User @relation(fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@map("moderation_actions")
}

/// Append-only (a database trigger rejects UPDATE and DELETE). No foreign keys, so history is
/// never lost or cascaded away.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?  @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetId, id])
  @@index([actorId, id])
  @@map("audit_logs")
}

enum DevicePlatform {
  IOS
  ANDROID
}

/// An Expo push token. One token belongs to one account at a time: registering it for another
/// account moves it, so a shared or handed-over phone never delivers the previous owner's alerts.
model DeviceToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @db.Uuid
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ---------------------------------------------------------------------------
// Phase 2: games and matches
// ---------------------------------------------------------------------------

enum MatchStatus {
  WAITING
  READY
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  ABANDONED
}

enum MatchKind {
  QUICK
  PRIVATE
  FRIEND
  BOT
}

enum MatchDeadlineKind {
  READY
  TURN
  NEXT_GAME
}

enum BotLevel {
  EASY
  MEDIUM
  HARD
}

/// Catalogue of games the server can host. Only enabled games can be started.
model Game {
  id         String  @id
  name       String
  enabled    Boolean @default(true)
  minPlayers Int     @db.SmallInt
  maxPlayers Int     @db.SmallInt

  matches GameMatch[]

  @@map("games")
}

/// One match (a best-of-three series for tic-tac-toe). The server owns every field; clients only
/// ever send intentions (ready, move, leave, rematch).
model GameMatch {
  id     String      @id @default(uuid(7)) @db.Uuid
  gameId String
  kind   MatchKind
  status MatchStatus

  /// Increases by the number of events appended by each change. Clients send the version they saw
  /// with every move, so a move made on stale information is refused.
  version Int @default(0)

  /// Serialised game-rules series state. Null until the match is active.
  state Json?

  /// What the server is waiting for next and by when. The sweeper acts on overdue deadlines, so a
  /// restart cannot leave a match stuck.
  deadlineKind MatchDeadlineKind?
  deadlineAt   DateTime?          @db.Timestamptz(3)

  /// score | forfeit | left | expired | cancelled. Null while the match is open.
  endReason  String?
  /// Winning seat; null for a drawn series or a match that never produced a result.
  winnerSeat Int?    @db.SmallInt

  /// Which seat opens game 1 (alternates from one rematch to the next).
  openingSeat          Int     @default(0) @db.SmallInt
  /// Bit 1 = seat 0 asked for a rematch, bit 2 = seat 1 did.
  rematchRequestedMask Int     @default(0) @db.SmallInt
  rematchMatchId       String? @unique @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  startedAt DateTime? @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)

  game          Game              @relation(fields: [gameId], references: [id])
  players       GameMatchPlayer[]
  events        GameEvent[]
  voiceSessions VoiceSession[]
  result        GameResult?
  rematchMatch  GameMatch?        @relation("Rematch", fields: [rematchMatchId], references: [id], onDelete: SetNull)
  rematchSource GameMatch?        @relation("Rematch")

  @@index([status, deadlineAt])
  @@map("game_matches")
}

/// A seat in a match: a human (userId) or a labelled bot (botLevel).
model GameMatchPlayer {
  matchId        String    @db.Uuid
  seat           Int       @db.SmallInt
  userId         String?   @db.Uuid
  botLevel       BotLevel?
  ready          Boolean   @default(false)
  /// When the server first saw this human with no open socket during an active match. Cleared on
  /// reconnect; if it stays set for the grace period the series is forfeited.
  disconnectedAt DateTime? @db.Timestamptz(3)
  /// When this player left or was removed from a game that goes on without them (Ludo with three
  /// or four players). They no longer count as being in an open match.
  outAt          DateTime? @db.Timestamptz(3)

  match GameMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, seat])
  @@index([userId])
  @@map("game_match_players")
}

/// Append-only log of everything that happened in a match, in order.
model GameEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  matchId        String   @db.Uuid
  /// 1, 2, 3 ... with no gaps; the match version equals the last seq.
  seq            Int
  type           String
  seat           Int?     @db.SmallInt
  /// Client idempotency key for moves; a retry with the same key is recognised and ignored.
  clientActionId String?  @db.Uuid
  data           Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  match GameMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, seq])
  @@unique([matchId, seat, clientActionId])
  @@map("game_events")
}

enum RoomStatus {
  OPEN
  STARTED
  CLOSED
  DECLINED
  EXPIRED
}

/// A private room (join by code) or a friend invite (the same room, restricted to one invitee).
/// At most one OPEN room per host; the service enforces it in a serializable transaction.
model GameRoom {
  id            String     @id @default(uuid(7)) @db.Uuid
  /// Six characters from an alphabet without look-alikes (no 0/O/1/I). Unique among all rooms.
  code          String     @unique
  gameId        String
  hostId        String     @db.Uuid
  /// Set for a friend invite: only this user can join.
  invitedUserId String?    @db.Uuid
  /// Players the game starts with when the room is full: 2 for tic-tac-toe, 2 to 4 for Ludo.
  seats         Int        @default(2)
  status        RoomStatus @default(OPEN)
  expiresAt     DateTime   @db.Timestamptz(3)
  matchId       String?    @unique @db.Uuid
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  respondedAt   DateTime?  @db.Timestamptz(3)

  host        User             @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  invitedUser User?            @relation("RoomInvitee", fields: [invitedUserId], references: [id], onDelete: Cascade)
  members     GameRoomMember[]

  @@index([hostId, status])
  @@index([invitedUserId, status])
  @@index([status, expiresAt])
  @@map("game_rooms")
}

/// A guest who joined a private room with the code, before the match starts. The host is not a member.
model GameRoomMember {
  id       String   @id @default(uuid(7)) @db.Uuid
  roomId   String   @db.Uuid
  userId   String   @db.Uuid
  joinedAt DateTime @default(now()) @db.Timestamptz(3)

  room GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation("RoomMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("game_room_members")
}

/// A player waiting for a quick match. One row per user (unique), deleted when matched, cancelled
/// or expired, so "has a row" means "is searching".
model MatchQueueEntry {
  id       String   @id @default(uuid(7)) @db.Uuid
  userId   String   @unique @db.Uuid
  gameId   String
  /// Skill rating captured when the search started (1000 until ratings exist in slice 2F).
  rating   Int
  /// How many players the searcher wants in the match (2 for tic-tac-toe, 2 to 4 for Ludo).
  seats    Int      @default(2)
  joinedAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation("QueueUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameId, joinedAt])
  @@map("match_queue_entries")
}

/// What a finished match did. One row per match (unique matchId), written in the same transaction
/// that completes the match, so ratings and XP can never be applied twice or half-applied.
model GameResult {
  id            String    @id @default(uuid(7)) @db.Uuid
  matchId       String    @unique @db.Uuid
  gameId        String
  kind          MatchKind
  /// Quick match between two humans: the only kind that moves ratings.
  ranked        Boolean
  /// False when a ranked pair had already played its allowance of rated games in 24 hours.
  ratingApplied Boolean
  /// "lowUserId:highUserId" for two-human matches, used for the repeat-pair allowance.
  pairKey       String?
  endReason     String?
  winnerSeat    Int?      @db.SmallInt
  endedAt       DateTime  @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  match   GameMatch          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  players GameResultPlayer[]

  @@index([pairKey, endedAt])
  @@index([gameId, endedAt])
  @@map("game_results")
}

model GameResultPlayer {
  resultId     String  @db.Uuid
  seat         Int     @db.SmallInt
  /// Null for a bot, or after the player deleted their account.
  userId       String? @db.Uuid
  /// 1 win, 0.5 draw, 0 loss.
  score        Float
  ratingBefore Int?
  ratingAfter  Int?
  xp           Int     @default(0)

  result GameResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  user   User?      @relation("ResultPlayerUser", fields: [userId], references: [id], onDelete: SetNull)

  @@id([resultId, seat])
  @@index([userId])
  @@map("game_result_players")
}

model PlayerRating {
  userId     String   @db.Uuid
  gameId     String
  rating     Int
  ratedGames Int      @default(0)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  user User @relation("PlayerRatingUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([gameId, rating(sort: Desc)])
  @@map("player_ratings")
}

model PlayerStatistics {
  userId        String @db.Uuid
  gameId        String
  played        Int    @default(0)
  wins          Int    @default(0)
  losses        Int    @default(0)
  draws         Int    @default(0)
  winStreak     Int    @default(0)
  bestWinStreak Int    @default(0)

  user User @relation("PlayerStatisticsUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@map("player_statistics")
}

model PlayerExperience {
  userId    String   @id @db.Uuid
  xp        Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  user User @relation("PlayerExperienceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_experience")
}

/// One stretch of voice by one player in one match: joined, then left. Usage metadata only (who,
/// which match, how long); there is no audio recording anywhere. Kept when the account is deleted
/// (userId becomes null) so usage totals stay correct.
model VoiceSession {
  id        String    @id @default(uuid(7)) @db.Uuid
  matchId   String    @db.Uuid
  userId    String?   @db.Uuid
  /// The Agora uid used in the channel: seat + 1, so it is unique within a match.
  agoraUid  Int
  channel   String
  joinedAt  DateTime  @db.Timestamptz(3)
  leftAt    DateTime? @db.Timestamptz(3)
  /// left (player), match_ended, blocked, timeout (sweeper).
  endReason String?
  /// Whole seconds between join and leave; set when the session closes.
  seconds   Int?

  match GameMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([matchId, leftAt])
  @@index([userId, joinedAt])
  @@map("voice_sessions")
}

/// Bonus coins: free play credit used for match entry fees and pots. Never bought, withdrawn,
/// sent to another player or exchanged for anything (decision #110). The balance is never
/// negative (database CHECK) and changes only together with a CoinLedger row.
model CoinWallet {
  userId    String   @id @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  user User @relation("CoinWalletUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("coin_wallets")
}

/// Append-only. `idempotencyKey` is unique, so one real-world event can pay or charge only once.
model CoinLedger {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @db.Uuid
  delta          Int
  balanceAfter   Int
  reason         String
  reference      String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  user User @relation("CoinLedgerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("coin_ledger")
}

/// Admin-editable amounts: starter, daily, levelUp (entry tiers arrive in slice 8B).
model CoinSetting {
  key       String   @id
  value     Int
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("coin_settings")
}
