{
  "name": "@gameverse/api",
  "version": "0.1.0",
  "private": true,
  "description": "GameVerse REST + WebSocket API (NestJS)",
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -D correctness src test prisma prisma.config.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "serve": "tsc -p tsconfig.build.json --incremental false && node dist/main.js",
    "start:prod": "node dist/main.js",
    "smoke:dist": "bash scripts/smoke-dist.sh",
    "test": "vitest run",
    "test:integration": "vitest run --config ./vitest.config.e2e.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@gameverse/shared-types": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "agora-token": "2.0.7",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.8",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^7.0.0",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "pino-pretty": "^13.0.0",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
