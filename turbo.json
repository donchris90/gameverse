{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "generate": {
      "outputs": ["src/generated/**"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build", "generate"]
    },
    "test:integration": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"]
    }
  }
}
