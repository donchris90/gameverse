# GameVerse environment template. PLACEHOLDERS ONLY - never commit real values.
#
# Local development:  cp .env.example apps/api/.env   then edit the values.
# Staging/production: set these in your hosting provider's secret manager, not in files.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development            # development | test | staging | production
PORT=3000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
# Set to "true" only when running behind a trusted reverse proxy / load balancer.
TRUST_PROXY=false

# --- Database --------------------------------------------------------------
# Local docker-compose / dev database (development credentials only).
DATABASE_URL=postgresql://gameverse:gameverse_dev_pw@localhost:5432/gameverse_dev
# Used by integration tests ONLY. Tests refuse to run unless the database name ends in "_test".
TEST_DATABASE_URL=postgresql://gameverse:gameverse_dev_pw@localhost:5432/gameverse_test

# --- Auth ------------------------------------------------------------------
# At least 32 random characters. Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated Client IDs the API will accept ID tokens for. Leave empty to disable the provider.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# --- Web / CORS ------------------------------------------------------------
# Base URL used to build links in emails (verification, password reset).
PUBLIC_WEB_URL=http://localhost:3000
# Comma-separated allowed browser origins (admin dashboard). Never "*" in staging/production.
CORS_ORIGINS=

# --- Email -----------------------------------------------------------------
# "console" prints emails (including links) to the log: DEVELOPMENT ONLY, refused in staging/production.
# No production email provider is integrated yet - see docs/progress.md.
EMAIL_PROVIDER=console
EMAIL_FROM=GameVerse <no-reply@example.invalid>

# --- Push notifications -----------------------------------------------------
# none = disabled, expo = Expo push service (EXPO_ACCESS_TOKEN optional but recommended).
PUSH_PROVIDER=none
EXPO_ACCESS_TOKEN=
PRESENCE_OFFLINE_GRACE_MS=5000

# --- Rate limiting (per client IP, per minute) -----------------------------
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=10

# --- Voice (Agora) ----------------------------------------------------------
# Create an Agora project and enable the App Certificate. Never commit real values.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
VOICE_TOKEN_TTL_SECONDS=3600
# Phase 0 two-phone spike only. Refused in staging/production.
VOICE_SPIKE_ENABLED=false
